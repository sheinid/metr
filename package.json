{
  "name": "metr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "build:pages": "npm run build -- --mode pages",
    "dev:agent": "METR_PLANNER_ENABLED=true METR_AGENT_PROVIDER=codex vite --host 127.0.0.1",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@resvg/resvg-js": "^2.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
